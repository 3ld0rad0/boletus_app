# Copia in .env e personalizza. Non committare mai il file .env.
DATABASE_URL=sqlite:///./boletus.db
# Obbligatorio, almeno 32 caratteri. Generalo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080
# Origini consentite separate da virgola (web e app Capacitor: Android https://localhost, iOS capacitor://localhost)
CORS_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost
