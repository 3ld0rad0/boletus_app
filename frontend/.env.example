# Su dispositivo/emulatore "localhost" è il telefono: usa l'indirizzo HTTPS del server (o l'IP del PC con HTTPS).
VITE_API_URL=http://localhost:8000
# Chiave Thunderforest (Outdoors); senza chiave si usa OpenTopoMap. Limitarla per dominio dal pannello Thunderforest.
VITE_THUNDERFOREST_API_KEY=
# Override opzionale delle tile (ha la precedenza su Thunderforest)
# VITE_TILE_URL=https://tile.opentopomap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=...
